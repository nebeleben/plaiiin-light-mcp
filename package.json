{
  "name": "plaiiin-lamp-mcp",
  "version": "0.3.4",
  "private": true,
  "description": "Local MCP server (stdio) that lets an AI assistant control PlaiiinLight lamps on the LAN",
  "type": "module",
  "scripts": {
    "build": "node esbuild.mjs",
    "pretest": "node scripts/check-vendor.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "bonjour-service": "1.4.4",
    "jpeg-js": "0.4.4",
    "jsqr": "1.4.0",
    "omggif": "1.0.10",
    "pngjs": "7.0.0",
    "ws": "8.22.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/omggif": "1.0.5",
    "@types/pngjs": "6.0.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
